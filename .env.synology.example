# Copy to .env.synology on the Synology. Do not commit the copied file.
# MYSQL_HOST must be the NAS LAN IP or DNS name, not 127.0.0.1.
MYSQL_HOST=192.168.1.50
# Use the port configured by the Synology MariaDB package (often 3306 or 3307).
MYSQL_PORT=3306
MYSQL_DATABASE=ross_inventories
MYSQL_USER=ross_inventory_app
MYSQL_PASSWORD=replace-with-the-database-password
# Generate a long random value and keep it unchanged after deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
PORT=8081
